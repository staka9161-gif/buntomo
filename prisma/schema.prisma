generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  handle        String?         @unique
  passwordHash  String?
  name          String
  image         String?
  emailVerified DateTime?
  bio           String?
  linkX         String?
  linkInstagram String?
  linkWebsite      String?
  linkWebsiteLabel String?
  area          String?
  customLinks   String?
  isPublic      Boolean         @default(true)
  isAdmin       Boolean         @default(false)
  visibility    String?
  emailNotifDM            Boolean @default(true)
  emailNotifFriendRequest Boolean @default(true)
  emailNotifFriendAccepted Boolean @default(true)
  notificationsLastSeenAt  DateTime?
  deactivatedAt            DateTime?
  scheduledDeletionAt      DateTime?
  accountStatus            String    @default("active")
  suspendedAt              DateTime?
  suspendedReason          String?
  suspendedUntil           DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  readings             ReadingStatus[]
  messages             ChatMessage[]
  readingEvents        ReadingEvent[]       @relation
  passwordResetTokens  PasswordResetToken[]
  friendshipsRequested Friendship[]         @relation("FriendshipsRequested")
  friendshipsReceived  Friendship[]         @relation("FriendshipsReceived")
  dmsSent              DirectMessage[]      @relation("DMsSent")
  dmsReceived          DirectMessage[]      @relation("DMsReceived")
  blockedUsers         Block[]              @relation("Blocker")
  blockedByUsers       Block[]              @relation("Blocked")
  reviews              Review[]
  accounts             Account[]
  emailVerificationTokens EmailVerificationToken[]
  mergeSuggestionsReported MergeSuggestion[] @relation("MergeSuggestionReporter")
  adminAuditLogs       AdminAuditLog[]       @relation("AdminAuditLogs")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminUserId  String?
  action       String
  targetType   String
  targetId     String?
  targetUserId String?
  reason       String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  admin User? @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@index([targetUserId])
  @@index([action, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Book {
  id               String   @id @default(cuid())
  isbn             String?  @unique
  title            String
  titleNormalized  String   @default("")
  titleKana        String?
  subtitle         String?
  seriesName       String?
  volume           String?
  author           String
  authorKana       String?
  publisher        String?
  publisherNormalized String?
  label            String?
  labelNormalized  String?
  publishedDate    String?
  totalPages       Int      @default(0)
  coverImageUrl    String?
  coverSource      String?
  description      String?
  sourceData       String?  // JSON: {"openbd": {...}, "ndl": {...}}

  // ランキング用フィールド（事前計算）
  publisherTier     String  @default("C") // S, A, B, C, D
  publisherScore    Int     @default(0)
  popularityScore   Int     @default(0)
  completenessScore Int     @default(0)
  freshnessScore    Int     @default(0)
  customRank        Int     @default(0)   // 全スコア合計、検索ソート用

  // フラグ
  isCanonical       Boolean @default(true)
  isElectronic      Boolean @default(false)
  isKarilRecommended Boolean @default(false)
  isLongseller      Boolean @default(false)
  registrationCount Int     @default(0)

  // Work/Edition 移行用（移行後は Edition 経由で参照）
  migratedWorkId    String?
  migratedEditionId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  readings      ReadingStatus[]
  messages      ChatMessage[]
  readingEvents ReadingEvent[]   @relation("PrimaryBook")
  events        ReadingEvent[]   @relation("EventBooks")

  @@index([title])
  @@index([titleNormalized])
  @@index([author])
  @@index([publisherNormalized])
  @@index([labelNormalized])
  @@index([customRank])
  @@index([seriesName])
}

// ============================================================
// Work/Edition モデル（作品と版の分離）
// ============================================================

model Work {
  id                 String   @id @default(cuid())
  title              String
  titleNormalized    String   @default("")
  author             String
  authorNormalized   String   @default("")
  originalTitle      String?  // 原題（翻訳書のみ）
  originalLanguage   String?
  description        String?
  ndlWorkId          String?  // 国立国会図書館典拠ID
  openlibraryWorkId  String?  // OpenLibrary Work ID
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  editions            Edition[]
  translationGroups   TranslationGroup[]
  reviews             Review[]
  mergeSuggestionsAsSource MergeSuggestion[] @relation("MergeSuggestionSource")
  mergeSuggestionsAsTarget MergeSuggestion[] @relation("MergeSuggestionTarget")
  readingStatuses     ReadingStatus[]
  chatMessages        ChatMessage[]
  readingEvents       ReadingEvent[]  @relation("WorkReadingEvents")

  @@index([titleNormalized])
  @@index([authorNormalized])
  @@index([ndlWorkId])
  @@index([openlibraryWorkId])
  @@index([originalTitle])
}

enum EditionFormat {
  hardcover
  paperback
  bunko
  shinsho
  ebook
  audiobook
  other
}

enum EditionSource {
  ndl
  openbd
  google_books
  rakuten
  manual
  user_submitted
}

model Edition {
  id                  String        @id @default(cuid())
  workId              String
  translationGroupId  String?
  isbn10              String?
  isbn13              String?       @unique
  publisher           String?
  format              EditionFormat @default(other)
  pageCount           Int?
  publishedAt         DateTime?
  coverImageUrl       String?
  titleOnCover        String        // 実際の書影に書かれているタイトル（巻数含む）
  source              EditionSource @default(manual)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  work              Work              @relation(fields: [workId], references: [id])
  translationGroup  TranslationGroup? @relation(fields: [translationGroupId], references: [id])
  reviews           Review[]
  readingStatuses   ReadingStatus[]

  @@index([workId])
  @@index([translationGroupId])
  @@index([isbn13])
}

model TranslationGroup {
  id                 String   @id @default(cuid())
  workId             String
  translator         String?  // 翻訳者名
  translatorNormalized String?
  label              String   // "新訳（光文社古典新訳文庫版）" など
  firstPublishedYear Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  work     Work      @relation(fields: [workId], references: [id])
  editions Edition[]

  @@index([workId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  editionId String?
  body      String
  rating    Int?     // 1-5
  postedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work    Work     @relation(fields: [workId], references: [id])
  edition Edition? @relation(fields: [editionId], references: [id])

  @@unique([userId, workId])
  @@index([workId])
  @@index([editionId])
}

enum MergeSuggestionStatus {
  pending
  approved
  rejected
}

model MergeSuggestion {
  id              String                @id @default(cuid())
  sourceWorkId    String
  targetWorkId    String
  score           Float?
  reason          String?
  status          MergeSuggestionStatus @default(pending)
  reporterUserId  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  sourceWork Work  @relation("MergeSuggestionSource", fields: [sourceWorkId], references: [id])
  targetWork Work  @relation("MergeSuggestionTarget", fields: [targetWorkId], references: [id])
  reporter   User? @relation("MergeSuggestionReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sourceWorkId])
  @@index([targetWorkId])
}

// ============================================================
// 既存モデル（workId/editionId を追加）
// ============================================================

enum ReadingStatusType {
  WANT_TO_READ
  READING
  COMPLETED
  DNF
}

model ReadingStatus {
  id          String            @id @default(cuid())
  userId      String
  bookId      String?
  workId      String?
  editionId   String?
  status      ReadingStatusType
  currentPage Int               @default(0)
  rating      Int?              // 1-5
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime          @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book?    @relation(fields: [bookId], references: [id])
  work    Work?    @relation(fields: [workId], references: [id])
  edition Edition? @relation(fields: [editionId], references: [id])

  @@unique([userId, bookId])
  @@index([bookId, status])
  @@index([bookId, completedAt])
  @@index([workId, status])
  @@index([editionId])
}

model ReadingEvent {
  id          String   @id @default(cuid())
  bookId      String?
  workId      String?
  organizerId String
  title       String
  eventDate   DateTime
  prefecture  String   @default("東京都")
  location    String
  url         String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book      Book?  @relation("PrimaryBook", fields: [bookId], references: [id])
  work      Work?  @relation("WorkReadingEvents", fields: [workId], references: [id])
  books     Book[] @relation("EventBooks")
  organizer User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([bookId, eventDate])
  @@index([workId, eventDate])
  @@index([eventDate])
  @@index([prefecture])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model ChatMessage {
  id        String   @id @default(cuid())
  bookId    String?
  workId    String?
  userId    String
  content   String
  window    String   @default("1w")
  createdAt DateTime @default(now())

  book Book? @relation(fields: [bookId], references: [id])
  work Work? @relation(fields: [workId], references: [id])
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, window, createdAt])
  @@index([workId, window, createdAt])
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender    User @relation("DMsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DMsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model SearchCache {
  queryHash       String   @id
  queryRaw        String
  queryNormalized String
  resultIsbns     String[]
  resultScores    Float[]
  sourcesUsed     String[]
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}

model LearningSignal {
  id              String   @id @default(cuid())
  queryNormalized String
  isbn            String?
  bookId          String?
  rankShown       Int      @default(0)
  action          String   // clicked, registered, read
  userId          String?
  createdAt       DateTime @default(now())

  @@index([queryNormalized])
  @@index([isbn])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
