{
  "name": "booktogether",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start",
    "lint": "eslint",
    "import:openbd": "npx tsx scripts/import-openbd.ts",
    "import:openbd:resume": "npx tsx scripts/import-openbd.ts --resume",
    "calculate:ranks": "npx tsx scripts/calculate-ranks.ts",
    "migrate:works": "npx tsx scripts/migrate-books-to-works.ts",
    "migrate:works:execute": "npx tsx scripts/migrate-books-to-works.ts --execute",
    "batch:matching": "npx tsx scripts/batch-matching.ts",
    "batch:matching:execute": "npx tsx scripts/batch-matching.ts --execute",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
